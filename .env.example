# Server Configuration
PORT=8000
NODE_ENV=development
APP_TIMEZONE=Africa/Lagos

# Database Configuration (MySQL / XAMPP defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=localspot_db
DB_CONNECTION_LIMIT=10

# Security & JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=1d

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=*

# Email Service (Resend)
RESEND_API_KEY=re_mock_api_key_123456789
RESEND_FROM_EMAIL=onboarding@resend.dev

# Location & Geocoding Service (Nominatim / OpenStreetMap)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=LocalspotBackend/1.0 (contact@example.com)
NOMINATIM_COUNTRY_CODES=ng
NOMINATIM_TIMEOUT_MS=5000
